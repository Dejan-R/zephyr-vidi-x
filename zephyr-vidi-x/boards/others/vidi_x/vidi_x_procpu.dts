 *
 * VIDI X v1.0 board definition.
 * Adapted from Zephyr's ESP32-DevKitC PROCPU board support.
 *
 * Tested:
 * - ILI9341 TFT display
 * - XPT2046 touchscreen
 * - LVGL 9
 *
 * Hardware configuration:
 * - VSPI_CS0: GAME USE
 * - D/C_LCD: GAME USE
 * - VSPI_CS2: GAME USE
 * - TOUCH_IRQ: USE EXP during reset/boot
 *
 * Known limitation:
 * GPIO12 is an ESP32 strapping pin. Connecting the
 * touchscreen IRQ during reset may prevent booting.
 *
 * Flash and PSRAM configurations require further validation.
 */


/dts-v1/;
#include <espressif/esp32/esp32_wrover_e_n4r8.dtsi>
#include <espressif/partitions_0x1000_amp.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/display/panel.h>
#include "vidi_x-pinctrl.dtsi"

/ {
    model = "VIDI X v1.0 ESP32-WROVER-B PROCPU";
    compatible = "espressif,esp32";

    aliases {
        uart-0 = &uart0;
        watchdog0 = &wdt0;
    };

    chosen {
        zephyr,sram = &sram1;
        zephyr,console = &uart0;
        zephyr,shell-uart = &uart0;
        zephyr,flash = &flash0;
        zephyr,code-partition = &slot0_partition;
        zephyr,display = &ili9341;
        zephyr,touch = &xpt2046;
        zephyr,bt-hci = &esp32_bt_hci;
    };

    lvgl_pointer {
        compatible = "zephyr,lvgl-pointer-input";
        input = <&xpt2046>;
    };

    mipi_dbi {
        compatible = "zephyr,mipi-dbi-spi";
        spi-dev = <&spi3>;
        dc-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;

        /* No GPIO22 LCD reset: on VIDI X this line serves other hardware. */
        #address-cells = <1>;
        #size-cells = <0>;

        ili9341: ili9341@0 {
            compatible = "ilitek,ili9341";
            reg = <0>;
            mipi-max-frequency = <20000000>;
            mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
            width = <240>;
            height = <320>;
            rotation = <270>;
            h-mirror;
            pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;
        };
    };
};

&gpio0 { status = "okay"; };
&gpio1 { status = "okay"; };

&uart0 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart0_default>;
    pinctrl-names = "default";
};

&i2c0 { status = "disabled"; };

&spi3 {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;
    pinctrl-0 = <&vidi_x_spim3_default>;
    pinctrl-names = "default";

    /* CS0: LCD at GPIO5; CS1: touch at GPIO4. */
    cs-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>,
               <&gpio0 4 GPIO_ACTIVE_LOW>;

    xpt2046: xpt2046@1 {
        compatible = "xptek,xpt2046";
        reg = <1>;
        spi-max-frequency = <1000000>;
        /* Original onboard IRQ on GPIO12 (a strapping pin). */
        int-gpios = <&gpio0 12 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        touchscreen-size-x = <240>;
        touchscreen-size-y = <320>;
        min-x = <0>;
        min-y = <0>;
        max-x = <4000>;
        max-y = <4000>;
    };
};

&esp32_bt_hci { status = "okay"; };
&wifi { status = "okay"; };
&trng0 { status = "okay"; };
