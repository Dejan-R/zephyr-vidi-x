# Minimal defaults matching the existing working DevKitC-based application.
CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_GPIO=y

# VIDI X v1.0 in this project uses an ESP32 silicon revision 1.
# That revision is NOT officially supported by Zephyr 4.4.2.
CONFIG_ESP32_USE_UNSUPPORTED_REVISION=y

# System heap for ESP32 drivers
CONFIG_HEAP_MEM_POOL_SIZE=8192